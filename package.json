{
  "name": "i18next-www",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "scripts": {
    "start": "npm run dev",
    "dev": "vike dev",
    "build": "vike build",
    "postbuild": "node scripts/postbuild.js && pagefind --site dist/client",
    "preview": "npm run build && wrangler dev --port 8790",
    "check": "node scripts/check.js",
    "test": "npm run lint && node --test \"src/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "facts": "node scripts/facts.js",
    "deploy": "wrangler deploy",
    "deploy:redirects": "wrangler deploy -c redirects/wrangler.jsonc"
  },
  "dependencies": {
    "i18next": "27.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vanilla-cookieconsent": "3.1.0",
    "vike": "0.4.266",
    "vike-react": "0.6.26"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.12.0",
    "neostandard": "0.13.0",
    "pagefind": "1.5.2",
    "rehype-highlight": "7.0.2",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
