// Static assets only, like locize.com's www and in the same account, which also holds the i18next.com zone.
// `npm run deploy` publishes to it, on the custom domain below; see "Deploy" in README.md. `npx wrangler dev` serves dist/client with _headers and
// _redirects applied (vike preview does not apply them).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "i18next-www",
  "account_id": "198b8acde27be4094cda0bd7ee1a7c9d",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "www.i18next.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
